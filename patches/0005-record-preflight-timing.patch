+class PreflightTimingCallback(TrainerCallback):
+    """Record pilot timing without changing the authors' training loop."""
+
+    def __init__(self, output_path):
+        self.output_path = output_path
+        self.steady_start = None
+        self.evaluation_seconds = []
+
+    @staticmethod
+    def _synchronize():
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+
+    def on_step_end(self, args, state, control, **kwargs):
+        if state.global_step == 20 and self.steady_start is None:
+            self._synchronize()
+            self.steady_start = time.perf_counter()
+        return control
+
+    def on_evaluate(self, args, state, control, metrics=None, **kwargs):
+        if self.steady_start is not None and metrics is not None:
+            runtime = metrics.get("eval_runtime")
+            if isinstance(runtime, (int, float)) and runtime >= 0:
+                self.evaluation_seconds.append(float(runtime))
+        return control
+
+    def on_train_end(self, args, state, control, **kwargs):
+        if self.steady_start is None:
+            return control
+        self._synchronize()
+        elapsed = time.perf_counter() - self.steady_start
+        payload = {
+            "schema_version": 1,
+            "completed_optimizer_steps": state.global_step,
+            "warmup_steps_excluded": 20,
+            "elapsed_seconds_steps_21_to_end": elapsed,
+            "evaluation_measurements_seconds": self.evaluation_seconds,
+            "non_evaluation_seconds_steps_21_to_end": max(
+                0.0, elapsed - sum(self.evaluation_seconds)
+            ),
+        }
+        with open(self.output_path, "w", encoding="utf-8") as stream:
+            json.dump(payload, stream, indent=2, sort_keys=True)
+            stream.write("\n")
+        return control
+
